            "post_content": "<!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"padding\":{\"right\":\"1vw\",\"left\":\"1vw\",\"top\":\"20px\",\"bottom\":\"0px\"}}},\"layout\":{\"inherit\":true}} -->\n<div class=\"wp-block-group alignwide\" style=\"padding-top:20px;padding-right:1vw;padding-bottom:0;padding-left:1vw;\"><!-- wp:media-text {\"mediaId\":46,\"mediaLink\":\"https:\/\/paytondemo.wordpress.com\/vanesa-conunaese-hoykfpi8yd4-unsplash\/\",\"mediaType\":\"image\",\"mediaWidth\":66,\"imageFill\":true} -->\n<div class=\"wp-block-media-text alignwide is-stacked-on-mobile is-image-fill\" style=\"grid-template-columns:66% auto;\"><figure class=\"wp-block-media-text__media\" style=\"background-image:url('https:\/\/paytondemo.files.wordpress.com\/2021\/11\/vanesa-conunaese-hoykfpi8yd4-unsplash.jpg?w=1024');background-position:50% 50%;\"><img src=\"https:\/\/paytondemo.files.wordpress.com\/2021\/11\/vanesa-conunaese-hoykfpi8yd4-unsplash.jpg?w=1024\" alt=\"\" class=\"wp-image-46 size-full\" \/><\/figure><div class=\"wp-block-media-text__content\"><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"6vh\",\"right\":\"40px\",\"bottom\":\"6vh\",\"left\":\"40px\"}},\"border\":{\"style\":\"solid\",\"width\":\"2px\",\"color\":\"#d5e1dc\"}},\"layout\":{\"inherit\":true}} -->\n<div class=\"wp-block-group has-border-color\" style=\"border-color:#d5e1dc;border-style:solid;border-width:2px;padding-top:6vh;padding-right:40px;padding-bottom:6vh;padding-left:40px;\"><!-- wp:heading {\"level\":5,\"textColor\":\"secondary\",\"fontSize\":\"small\"} -->\n<h5 class=\"has-secondary-color has-text-color has-small-font-size\" id=\"welcome\"><strong>WELCOME!<\/strong><\/h5>\n<!-- \/wp:heading -->\n\n<!-- wp:heading {\"style\":{\"typography\":{\"lineHeight\":\"1.35\",\"fontWeight\":\"500\"}},\"textColor\":\"primary\"} -->\n<h2 class=\"has-primary-color has-text-color\" id=\"simple-tips-for-natural-living\" style=\"font-weight:500;line-height:1.35;\"><strong>Simple Tips for Natural Living<\/strong><\/h2>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Holistic lifestyle advice for families looking to eat wholesome foods, and live more sustainably.<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"backgroundColor\":\"secondary\",\"style\":{\"border\":{\"radius\":\"0px\"},\"spacing\":{\"padding\":{\"top\":\"10px\",\"bottom\":\"10px\",\"left\":\"20px\",\"right\":\"20px\"}}},\"fontSize\":\"small\"} -->\n<div class=\"wp-block-button has-custom-font-size has-small-font-size\"><a class=\"wp-block-button__link has-secondary-background-color has-background\" style=\"border-radius:0;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px;\"><strong>START HERE<\/strong><\/a><\/div>\n<!-- \/wp:button --><\/div>\n<!-- \/wp:buttons --><\/div>\n<!-- \/wp:group --><\/div><\/div>\n<!-- \/wp:media-text --><\/div>\n<!-- \/wp:group -->\n\n<!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"padding\":{\"right\":\"0vw\",\"left\":\"0vw\",\"top\":\"0px\",\"bottom\":\"0px\"}},\"border\":{\"width\":\"2px\"}},\"layout\":{\"inherit\":false}} -->\n<div class=\"wp-block-group alignwide\" style=\"border-width:2px;padding-top:0;padding-right:0;padding-bottom:0;padding-left:0;\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"border\":{\"width\":\"2px\"},\"spacing\":{\"padding\":{\"top\":\"0px\",\"right\":\"1vw\",\"left\":\"1vw\"}}}} -->\n<div class=\"wp-block-group alignwide\" style=\"border-width:2px;padding-top:0;padding-right:1vw;padding-left:1vw;\"><!-- wp:columns {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-columns are-vertically-aligned-center\"><!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"40%\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\" style=\"flex-basis:40%;\"><!-- wp:separator {\"customColor\":\"#d5e1dc\",\"className\":\"is-style-wide\"} -->\n<hr class=\"wp-block-separator has-text-color has-background is-style-wide\" sty